# --- Required ---------------------------------------------------------------

# Signs session JWTs. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Used by the synthesis pipeline. Get one at https://console.anthropic.com
# The app runs without it — ingestion and every read view work — but Run
# discovery returns a clear error instead of a plan, and uploaded screenshots
# are stored without being read, because transcribing one needs a model.
#
# No quotes, no spaces: ANTHROPIC_API_KEY=sk-ant-...
# This file is read once when the server starts. Adding the key while
# `npm run dev` is running does nothing until you restart it.
ANTHROPIC_API_KEY=


# --- Optional ---------------------------------------------------------------

# Leave unset for local development: the app falls back to PGlite, an embedded
# Postgres that stores its data in ./.pglite and needs no server or Docker.
# Set it to a Neon (or any Postgres) connection string for staging/production.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Overrides the model used for synthesis. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5


# --- Deploying -----------------------------------------------------------
#
# Vercel + Neon. Create a Neon project, copy its pooled connection string into
# DATABASE_URL, and set AUTH_SECRET and ANTHROPIC_API_KEY in the Vercel project
# settings. vercel.json runs migrations as part of the build, so the schema and
# the RLS policies are applied before the new deployment goes live.
#
# Use a *separate* Neon branch for preview deployments so a preview never writes
# to production data. Neon branching makes this a one-click operation.
#
# Note for whoever picks this up: nothing here uses AWS, and nothing should.
